<!DOCTYPE html>
<html>
<head>
<title>Add Student</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>

<h1>Add Student</h1>

<form action="/add" method="POST">

<input
type="text"
name="name"
placeholder="Name"
required>

<input
type="number"
name="age"
placeholder="Age"
required>

<input
type="text"
name="course"
placeholder="Course"
required>

<button>Add Student</button>

</form>

<a href="/">Back</a>

</body>
</html>